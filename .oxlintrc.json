{
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": [
    "graphify-out/**",
    ".gitnexus/**",
    ".teamai/**",
    "**/node_modules/**",
    "evals/tasks/*/workspace/**"
  ],
  "globals": {
    "Bun": "readonly"
  },
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["_meta"] }]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-console": ["error", { "allow": ["error"] }]
      }
    },
    {
      "files": ["tests/**/*.ts", "scripts/**/*.ts", "evals/**/*.ts"],
      "plugins": ["typescript", "unicorn", "oxc"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
