{
  "name": "typesafe-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing TypeSafe AI's Jev decision model (Choice / Score / Noul) as typed tools.",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "typesafe-mcp": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint",
    "test": "bun test --path-ignore-patterns='**/integration/**'",
    "test:all": "bun test",
    "test:integration": "bun test tests/integration",
    "test:stdio": "bun test tests/stdio.test.ts",
    "inspect": "bunx @modelcontextprotocol/inspector bun run src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.4.2",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  }
}
