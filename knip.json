{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.ts",
    "evals/tasks/*/generate.ts",
    "tests/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "evals/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignore": [
    "evals/tasks/*/workspace/**"
  ],
  "ignoreExportsUsedInFile": true
}
